{
  "name": "corporate-games-home",
  "version": "2.0.0",
  "private": true,
  "description": "home.corporatetambola.com: plain static pages. One small build step (tools/build.mjs) writes dist/ with version.json. Tests: Playwright + axe-core (npm ci, then npx playwright install chromium).",
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "contrast": "node tools/contrast-pairs.mjs",
    "links": "node tools/build.mjs && node tests/run.mjs --only T01,T02",
    "test": "node tools/build.mjs && node tests/run.mjs",
    "falsify": "node tests/falsify.mjs",
    "serve": "node tests/serve.mjs",
    "test:laptop": "node C:/ct/test-sites/console/tools/heavy-run.mjs -- node tests/run.mjs",
    "falsify:laptop": "node C:/ct/test-sites/console/tools/heavy-run.mjs -- node tests/falsify.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "axe-core": "^4.11.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
